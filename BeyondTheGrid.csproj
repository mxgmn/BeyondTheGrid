<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>BeyondTheGrid</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <OutputPath>bin\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>
  
    <ItemGroup>
      <None Update="games.lisp;games\**\*;resources\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="7.0.1" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="VIDEO\**\*.cs" />
    </ItemGroup>

    <Target Name="RemoveUnwantedRuntimes" AfterTargets="Build">
        <RemoveDir Directories="$(OutputPath)runtimes\linux-x64" />
        <RemoveDir Directories="$(OutputPath)runtimes\osx-x64" />
        <RemoveDir Directories="$(OutputPath)runtimes\unix" />
        <RemoveDir Directories="$(OutputPath)runtimes\win-x86" />
        <RemoveDir Directories="$(OutputPath)runtimes\win" />
        <RemoveDir Directories="$(OutputPath)runtimes\osx-arm64" />
    </Target>

	<PropertyGroup>
		<NoWarn>$(NoWarn);0162</NoWarn>
	</PropertyGroup>
</Project>
